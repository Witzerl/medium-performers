    "from tensorboard.backend.event_processing import event_accumulator\n",
    "import numpy as np\n",
    "\n",
    "# Load event data\n",
    "ea = event_accumulator.EventAccumulator(\"./runs/run_2025-05-12_19-36-47\")\n",
    "ea.Reload()\n",
    "\n",
    "# Extract scalar values\n",
    "train_loss      = np.array([e.value for e in ea.Scalars(\"train/loss\")])\n",
    "train_avg_loss  = np.array([e.value for e in ea.Scalars(\"train/avg_loss\")])\n",
    "valid_loss      = np.array([e.value for e in ea.Scalars(\"valid/loss\")])\n",
    "valid_avg_loss  = np.array([e.value for e in ea.Scalars(\"valid/avg_loss\")])\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "ed11f0e3",
   "metadata": {
    "collapsed": false,
    "jupyter": {
     "outputs_hidden": false
    }
   },
   "outputs": [],
   "source": [
    "train_loss_steps     = np.array([e.step for e in ea.Scalars(\"train/loss\")])\n",
    "train_avg_loss_steps = np.array([e.step for e in ea.Scalars(\"train/avg_loss\")])\n",
    "valid_loss_steps     = np.array([e.step for e in ea.Scalars(\"valid/loss\")])\n",
    "valid_avg_loss_steps = np.array([e.step for e in ea.Scalars(\"valid/avg_loss\")])\n",
    "\n",
    "train_loss      = np.array([e.value for e in ea.Scalars(\"train/loss\")])\n",
    "train_avg_loss  = np.array([e.value for e in ea.Scalars(\"train/avg_loss\")])\n",
    "valid_loss      = np.array([e.value for e in ea.Scalars(\"valid/loss\")])\n",
    "valid_avg_loss  = np.array([e.value for e in ea.Scalars(\"valid/avg_loss\")])\n",
    "\n",
    "import matplotlib.pyplot as plt\n",
    "\n",
    "#plt.plot(train_loss_steps, train_loss, label=\"Train Loss\", alpha=0.5)\n",
    "plt.plot(train_avg_loss_steps, train_avg_loss, label=\"Train Avg Loss\")\n",
    "#plt.plot(valid_loss_steps, valid_loss, label=\"Valid Loss\", alpha=0.5)\n",
    "plt.plot(valid_avg_loss_steps, valid_avg_loss, label=\"Valid Avg Loss\")\n",
    "\n",
    "plt.xlabel(\"Epoch\")\n",
    "plt.ylabel(\"Loss\")\n",
    "plt.title(\"Loss Curves\")\n",
    "plt.legend()\n",
    "plt.grid(True)\n",
    "plt.tight_layout()\n",
    "plt.show()\n"
   ]
