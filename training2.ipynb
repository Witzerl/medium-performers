    "### create the full image dataset\n",
    "\n",
    "VALIDATION_ROOT_DIR  = './MICCAI-LH-BraTS2025-MET-Challenge-Validation/'\n",
    "\n",
    "fullval_dataset = BrainMetFullVolumeDataset(root_dir=VALIDATION_ROOT_DIR)\n",
    "full_validation_dataset = DataLoader(fullval_dataset, batch_size=1, num_workers=4, shuffle=False, pin_memory=True)\n",
    "\n",
    "# Test a single sample\n",
    "for i, (x, y) in enumerate(full_validation_dataset):\n",
